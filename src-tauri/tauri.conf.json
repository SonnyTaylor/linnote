{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/schema.json",
  "productName": "Linnote",
  "version": "0.1.0",
  "identifier": "com.linnote.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "targets": ["appimage", "deb", "rpm"],
    "shortDescription": "OneNote desktop client for Linux",
    "longDescription": "Linnote is a native desktop wrapper for Microsoft OneNote Web, bringing full OneNote functionality to Linux with desktop integration features."
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["onenote"]
      }
    }
  }
}
